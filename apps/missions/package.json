    "@types/node": "latest",
    "cf": "^1.0.0-beta.19",
    "tsrs": "^0.18.0-ts7.1.0-dev.20260929",
    "typescript": "^5.5.0",
    "vite": "^8.0.0"
  },
  "description": "Alfred.report Missions Worker: missions, evidence gates, knowledge graph, scheduled workflows."
}

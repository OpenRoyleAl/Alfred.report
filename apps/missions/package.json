{
  "name": "alfred-report-missions",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cf dev",
    "build": "cf build",
    "deploy": "cf deploy",
    "check": "ALFRED_CONFIG_CHECK=1 cf deploy --dry-run",

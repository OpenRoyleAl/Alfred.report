{
  "name": "alfred-report",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "overrides": {
    "nf3": "0.3.17"
  },
  "scripts": {
    "dev": "node scripts/with-app-env.mjs vite dev --host 0.0.0.0 --port 8080",
    "build": "node scripts/with-app-env.mjs vite build && npm run db:migrate",
    "db:migrate": "node scripts/migrate.mjs",
    "build:dev": "node scripts/with-app-env.mjs vite build --mode development",
    "preview": "node scripts/with-app-env.mjs vite preview",
    "preview:restart": "node scripts/preview.mjs restart",
    "preview:stop": "node scripts/preview.mjs stop",
    "typecheck": "tsrs --noEmit && npm --prefix apps/missions run typecheck && npm --prefix apps/oral run typecheck",
    "check:auth": "node scripts/check-auth-invariant.mjs",
    "test:rust": "cargo test --manifest-path crates/alfred-core/Cargo.toml",
    "build:rust": "cargo build --release --target wasm32-unknown-unknown --manifest-path crates/alfred-core/Cargo.toml && cp crates/alfred-core/target/wasm32-unknown-unknown/release/alfred_core.wasm src/alfred/wasm/",
    "test": "node --test 'scripts/**/*.test.mjs' && npm run test:src && npm run eval",
    "eval": "node --experimental-strip-types --import ./scripts/test-core.ts evals/run.ts",
    "test:src": "node --experimental-strip-types --import ./scripts/test-core.ts --test src/lib/app-data/app-data.test.ts src/lib/auth/gate-identity.test.ts src/lib/auth/sign-in-gate.test.ts src/lib/access.test.ts src/alfred/guards.test.ts src/alfred/review.test.ts src/alfred/clef.test.ts src/alfred/clairic.test.ts src/alfred/search.test.ts src/alfred/exa-lite.test.ts src/alfred/report.test.ts src/alfred/models.test.ts apps/oral/src/wake.test.ts apps/oral/src/turn.test.ts apps/oral/src/identity.test.ts src/alfred/extensions/extensions.test.ts src/mcp/server.test.ts src/lib/tenant.test.ts src/alfred/bind.test.ts src/lib/mail.test.ts src/lib/google-auth.test.ts src/alfred/fetch-guard.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "secret-scan": "node scripts/secret-scan.mjs",
    "gate": "npm run typecheck && npm test && npm run config:check && npm run secret-scan && npm run deploy:check",
    "setup": "bash scripts/setup.sh",
    "install:all": "npm ci && npm ci --prefix deploy/web && npm ci --prefix apps/missions && npm ci --prefix apps/oral",
    "deploy": "npm --prefix apps/missions run deploy && npm --prefix deploy/web run deploy && npm --prefix apps/oral run deploy",
    "deploy:check": "npm --prefix apps/missions run check && npm --prefix deploy/web run check && npm --prefix apps/oral run check",
    "config:docs": "node scripts/config-docs.mjs",
    "config:check": "node scripts/config-docs.mjs --check",
    "seed:memory": "node scripts/seed-memory.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-durable": "^1.3.0",
    "@electric-sql/pglite": "^0.5.4",
    "@hookform/resolvers": "^5.7.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.168.0",
    "@tanstack/react-table": "^8.21.0",
    "@tanstack/router-plugin": "^1.168.0",
    "agents": "^0.28.1",
    "better-auth": "~1.6.30",
    "canvas": "^3.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.0.0",
    "jose": "6.2.9",
    "kysely": "^0.28.5",
    "lucide-react": "^0.510.0",
    "pg": "^8.16.3",
    "postal-mime": "^2.7.6",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.54.0",
    "react-resizable-panels": "^4.6.5",
    "recharts": "^2.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.3.4",
    "typebox": "^1.4.2",
    "vaul": "^1.1.2",
    "zod": "^4.4.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260829.1",
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "cf": "^1.0.0-beta.19",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "lightningcss": "^1.28.0",
    "nitro": "3.0.260610-beta",
    "playwright": "^1.62.0",
    "prettier": "^3.4.0",
    "tsrs": "^0.18.0-ts7.1.0-dev.20260929",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.2.0"
  },
  "description": "Alfred.report — voice-first operator on Cloudflare Workers",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenRoyleAl/Alfred.report.git"
  },
  "homepage": "https://alfred.report",
  "bugs": {
    "url": "https://github.com/OpenRoyleAl/Alfred.report/issues"
  },
  "keywords": [
    "alfred",
    "alfred-report",
    "cloudflare",
    "workers",
    "voice",
    "agents",
    "typescript",
    "durable-objects"
  ]
}

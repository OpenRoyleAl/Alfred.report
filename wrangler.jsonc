{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "command-os-review",
  "main": "src/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },

  "services": [
    { "binding": "AGENT_ALFRED", "service": "agent-alfred" },
    { "binding": "ALFRED_REPORT", "service": "alfred-report" }
  ],

  "agent_memory": [
    {
      "binding": "ALFRED_MEMORY",
      "namespace": "alfred"
    }
  ],

  "kv_namespaces": [
    { "binding": "ALFRED_COMMAND", "id": "c6567e729ec146be9d0be125e3cdf5e3" }
  ],

  "d1_databases": [
    { "binding": "DB", "database_name": "alfred-db", "database_id": "4e8eda20-5b52-4823-8aed-60df9a7cb474" }
  ],

  "r2_buckets": [
    { "binding": "ALFRED_DATA", "bucket_name": "alfred-data" },
    { "binding": "ALFRED_SNAPSHOTS", "bucket_name": "alfred-snapshots" }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "MISSION_STATE", "class_name": "MissionStateDO" },
      { "name": "VOICE_SESSION", "class_name": "VoiceSessionDO" }
    ]
  },
  "exports": {
    "MissionStateDO": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "VoiceSessionDO": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },

  "ai": { "binding": "AI" },

  "ai_search_namespaces": [
    { "binding": "AI_SEARCH", "namespace": "default" }
  ],

  "browser": {
    "binding": "BROWSER"
  },

  "analytics_engine_datasets": [
    { "binding": "ALFRED_COP", "dataset": "alfred_cop" }
  ],

  "secrets_store_secrets": [
    { "binding": "OPENAI_API_KEY", "store_id": "00f7b300af064e3eaa770cb5f7ca45f3", "secret_name": "OPENAI_API_KEY" },
    { "binding": "MIMO_API_KEY", "store_id": "00f7b300af064e3eaa770cb5f7ca45f3", "secret_name": "MIMO_API_KEY" },
    { "binding": "XAI_API_KEY", "store_id": "00f7b300af064e3eaa770cb5f7ca45f3", "secret_name": "XAI_API_KEY" },
    { "binding": "CF_API_TOKEN", "store_id": "00f7b300af064e3eaa770cb5f7ca45f3", "secret_name": "CF_API_TOKEN" },
    { "binding": "SIRI_BRIEFING_TOKEN", "store_id": "00f7b300af064e3eaa770cb5f7ca45f3", "secret_name": "SIRI_BRIEFING_TOKEN" }
  ],

  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "hans@icebergmedia.co.uk",
      "allowed_sender_addresses": ["alfred@alfred.report"]
    }
  ],

  "vars": {
    "ENVIRONMENT": "production",
    "CF_ACCOUNT_ID": "0870b0bdbc14bcd31f43fe5e82c3ee8e",
    "AI_GATEWAY_ID": "alfred-gateway",
    "AI_GATEWAY_URL": "https://gateway.ai.cloudflare.com/v1/0870b0bdbc14bcd31f43fe5e82c3ee8e/alfred-gateway",
    "TTS_PROVIDER": "workers-ai",
    "STT_PROVIDER": "workers-ai",
    "VOICE_MODEL": "aura-2-en",
    "ALFRED_PERSONALITY": "warm-british-male-authoritative-concise-dry-wit",
    "WALLET_HANDLE": "alfred"
  },

  "routes": [
    { "pattern": "alfred.report/*", "zone_name": "alfred.report" },
    { "pattern": "voice.alfred.report/*", "zone_name": "alfred.report" },
    { "pattern": "speak.alfred.report/*", "zone_name": "alfred.report" },
    { "pattern": "mcp.alfred.report/*", "zone_name": "alfred.report" }
  ]
}
